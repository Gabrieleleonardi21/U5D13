# Copia in .env e compila. .env NON va committato.
DB_URL=jdbc:postgresql://localhost:5432/biblioteca
DB_USERNAME=postgres
DB_PASSWORD=

# Obbligatorio (nessun default): almeno 32 caratteri casuali
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# In locale (http) il cookie del token non può essere Secure
COOKIE_SECURE=false

SUPERUSER_EMAIL=superuser@biblioteca.it
# Obbligatoria (nessun default)
SUPERUSER_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
